# Salin ke .env.local. Isi dari proyek Sanity milik pengguna/Putri yang benar.
# Kedua identifier ini publik, bukan token. Sengaja kosong; jangan isi dengan nilai rekaan.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# API version dipin di src/sanity/env.ts, bukan tanggal yang berubah setiap request.
# Query publik tetap tanpa token. Studio memakai login Sanity.
# Hanya server: token Viewer/read-only untuk draft dan validasi preview Studio.
# Isi dari API > Tokens proyek yang benar; jangan memakai NEXT_PUBLIC atau menaruhnya dalam URL.
SANITY_API_READ_TOKEN=
# Webhook/provider belum diimplementasikan. Jangan menambahkan secret NEXT_PUBLIC.

# Origin canonical/metadata publik. Gunakan URL situs utama, bukan URL deployment sementara.
SITE_URL=https://putriwellasibarani.vercel.app
